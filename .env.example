# TrustGraph Configuration
# Copy to .env and set your own values

# Server
TRUSTGRAPH_PORT=8080
TRUSTGRAPH_ENVIRONMENT=development
TRUSTGRAPH_LOG_LEVEL=debug

# Database
TRUSTGRAPH_DATABASE_URL=postgres://username:password@localhost:5432/trustgraph?sslmode=require

# Assessment service
TRUSTGRAPH_ASSESSMENT_TIMEOUT_MS=300

# Circuit breaker
TRUSTGRAPH_CIRCUIT_BREAKER_MAX_FAILURES=5
TRUSTGRAPH_CIRCUIT_BREAKER_WINDOW_MINS=5

# Idempotency cache TTL (hours)
TRUSTGRAPH_IDEMPOTENCY_TTL_HOURS=24

# Phase 1.5: shadow mode + admin access
# Set ENFORCEMENT_ENABLED=false to run assessments without enforcing capability gates
TRUSTGRAPH_ENFORCEMENT_ENABLED=false
# Admin token for /v1/admin/* endpoints — generate with: openssl rand -hex 32
TRUSTGRAPH_ADMIN_TOKEN=
# Risk-score cutoff (0-100) that /v1/metrics/calibration and trustgraph-simulate
# both evaluate against — keep this in sync with whatever threshold enforcement
# will eventually use, so calibration numbers reflect the real candidate cutoff.
TRUSTGRAPH_ENFORCEMENT_THRESHOLD=80

# ---------------------------------------------------------------------------
# Plane B: consented verification
#
# Every setting below is optional. When a vendor's credentials are absent, its
# endpoint returns 503 not_configured — it never returns a passing result it
# did not obtain. Do not commit real values; set these in the deployment
# environment only.
# ---------------------------------------------------------------------------

# LinkedIn OAuth. All three are required for the LinkedIn flow.
# Redirect URI must match the one registered with the LinkedIn app.
TRUSTGRAPH_LINKEDIN_CLIENT_ID=
TRUSTGRAPH_LINKEDIN_CLIENT_SECRET=
TRUSTGRAPH_LINKEDIN_REDIRECT_URI=

# Government ID verification (e.g. Persona). ID_VENDOR_NAME is recorded in the
# audit trail so a multi-vendor setup stays attributable.
TRUSTGRAPH_ID_VENDOR_BASE_URL=https://withpersona.com/api/v1
TRUSTGRAPH_ID_VENDOR_API_KEY=
TRUSTGRAPH_ID_VENDOR_NAME=persona

# Liveness / proof-of-person. Falls back to the ID vendor settings when unset.
TRUSTGRAPH_LIVENESS_VENDOR_BASE_URL=
TRUSTGRAPH_LIVENESS_VENDOR_API_KEY=

# Reverse-image search and synthetic-image detection. The two are independent:
# configuring only one still returns that one's result.
TRUSTGRAPH_REVERSE_IMAGE_BASE_URL=
TRUSTGRAPH_REVERSE_IMAGE_API_KEY=
TRUSTGRAPH_SYNTHETIC_IMAGE_BASE_URL=
TRUSTGRAPH_SYNTHETIC_IMAGE_API_KEY=

# ---------------------------------------------------------------------------
# Plane C: investigations
#
# Investigation endpoints are unavailable (503) unless INVESTIGATOR_TOKEN is
# set. Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# Bearer token for /v1/investigations/*, granting the "investigator" role.
TRUSTGRAPH_INVESTIGATOR_TOKEN=
# How long a break-glass grant stays valid. Capped at 240 minutes in code.
TRUSTGRAPH_BREAK_GLASS_DURATION_MINUTES=60

# OSINT tools. theHarvester and SpiderFoot CLI are separate binaries; SpiderFoot
# can also be reached over its REST API when a base URL is configured.
TRUSTGRAPH_HARVESTER_BINARY=theHarvester
TRUSTGRAPH_SPIDERFOOT_BASE_URL=
TRUSTGRAPH_SPIDERFOOT_API_KEY=
TRUSTGRAPH_SPIDERFOOT_BINARY=spiderfoot

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Postgres DSN for the store integration tests. Left unset, those tests skip.
# Run them with: TEST_DATABASE_URL=... go test -tags=integration ./internal/store/...
TEST_DATABASE_URL=

