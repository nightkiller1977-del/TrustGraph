# TrustGraph Configuration
# Copy to .env and set your own values

# Server
TRUSTGRAPH_PORT=8080
TRUSTGRAPH_ENVIRONMENT=development
TRUSTGRAPH_LOG_LEVEL=debug

# Database
TRUSTGRAPH_DATABASE_URL=postgres://username:password@localhost:5432/trustgraph?sslmode=require

# Assessment service
TRUSTGRAPH_ASSESSMENT_TIMEOUT_MS=300

# Circuit breaker
TRUSTGRAPH_CIRCUIT_BREAKER_MAX_FAILURES=5
TRUSTGRAPH_CIRCUIT_BREAKER_WINDOW_MINS=5

# Idempotency cache TTL (hours)
TRUSTGRAPH_IDEMPOTENCY_TTL_HOURS=24

# Phase 1.5: shadow mode + admin access
# Set ENFORCEMENT_ENABLED=false to run assessments without enforcing capability gates
TRUSTGRAPH_ENFORCEMENT_ENABLED=false
# Admin token for /v1/admin/* endpoints — generate with: openssl rand -hex 32
TRUSTGRAPH_ADMIN_TOKEN=
