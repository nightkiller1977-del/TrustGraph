# TrustGraph Configuration

# Server
TRUSTGRAPH_PORT=8080
TRUSTGRAPH_ENVIRONMENT=development
TRUSTGRAPH_LOG_LEVEL=debug

# Database
TRUSTGRAPH_DATABASE_URL=postgres://trustgraph:trustgraph_dev_password@localhost:5432/trustgraph

# Assessment service
TRUSTGRAPH_ASSESSMENT_TIMEOUT_MS=300

# Circuit breaker
TRUSTGRAPH_CIRCUIT_BREAKER_MAX_FAILURES=5
TRUSTGRAPH_CIRCUIT_BREAKER_WINDOW_MINS=5
