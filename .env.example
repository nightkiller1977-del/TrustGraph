# TrustGraph Configuration
# Uses ConnectionSphere's PostgreSQL instance (same Postgres 17-alpine container)

# Server
TRUSTGRAPH_PORT=8080
TRUSTGRAPH_ENVIRONMENT=development
TRUSTGRAPH_LOG_LEVEL=debug

# Database — shared ConnectionSphere Postgres, separate database
TRUSTGRAPH_DATABASE_URL=postgres://connectsphere:connectsphere_dev_password@localhost:5432/trustgraph?sslmode=disable

# Assessment service
TRUSTGRAPH_ASSESSMENT_TIMEOUT_MS=300

# Circuit breaker
TRUSTGRAPH_CIRCUIT_BREAKER_MAX_FAILURES=5
TRUSTGRAPH_CIRCUIT_BREAKER_WINDOW_MINS=5

# Idempotency cache TTL (hours)
TRUSTGRAPH_IDEMPOTENCY_TTL_HOURS=24
